{
  "name": "vantelier-shop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests docs scripts *.ts *.mjs *.md .github/workflows",
    "format:check": "prettier --check src tests docs scripts *.ts *.mjs *.md .github/workflows",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "start": "next start --hostname 127.0.0.1 --port 3200"
  },
  "dependencies": {
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "agent-browser": "0.42.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "minimatch@>=7.0.0 <=11.0.0": "11.0.7"
  }
}
