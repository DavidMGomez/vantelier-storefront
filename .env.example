COMMERCE_PROVIDER=medusa
# Variables del servidor Next.js; no usar credenciales administrativas.
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
# El seed del backend genera .local/storefront.env con estos valores reales.
# Copiar ese archivo a .env.local de este repositorio.
# Alternativa sin backend: COMMERCE_PROVIDER=demo.
